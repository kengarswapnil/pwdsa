import java.util.*;
class Main {
    public static void main(String[] args) {
      int arr [] = {2,1,3,5,0};
      System.out.print(MissingNumber(arr));
    }
    
    public static int MissingNumber(int arr[]){
          Arrays.sort(arr);
          for(int i=0;i<arr.length;i++){
          if(arr[i] != i){
             return i;
          }
      }
      return arr.length;
    }
}
