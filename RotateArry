import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[] ={1,0,2,3,0,3};
        // allZeroEnd(arr);
        int k =3;
        
        int n = arr.length;
        
        k = k%n;
        
        
        
        
        
        RotateArry(arr,0,n-1);
        RotateArry(arr,0,k-1);
        RotateArry(arr,k,n-1);
        
        
        for(int num:arr){
              System.out.print(num + " ");
        }
        
        
    }
    
    public static void allZeroEnd(int arr[]){
        int res[] =  new int[arr.length];
        int idx = 0;
        for(int i=0;i<arr.length;i++){
            if(arr[i] != 0){
                res[idx++] = arr[i];
            }
        }
        
        for(int i=0;i<arr.length;i++){
            System.out.print(res[i]+ " ");
        }
    }
    
    
    public static void RotateArry(int arr[],int start ,int end ){
     while(start <= end){
         int temp = arr[start];
         arr[start] =  arr[end];
         arr[end] =temp;
         start++;
         end--;
        
     }
    
    }
    
}
