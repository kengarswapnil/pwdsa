class Solution {
    public int findNumbers(int[] nums) {
        int count = 0;
        for(int i=0;i<nums.length;i++){
            if(even(nums[i])){
                count++;
            }      
        }
        return count;
    }

    public static boolean even(int number){

        int num  = digits(number);
        if(num  % 2 ==0){
            return true;
        }

        return false;
    }

    public static int digits(int num){
        int count = 0;
        while(num > 0){
            count++;
            num = num /10;
        }

        return count;
    }
}
