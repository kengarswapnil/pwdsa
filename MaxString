
class Main {
    public static void main(String[] args) {
       String s [] = {"120","300","1003"};
       int mx = Integer.parseInt(s[0]);
       for(int i=0;i<s.length();i++){
           int n = Integer.parseInt(s[i]);
           mx = Math.max(mx,n);
       }
       
       System.out.println(mx);
    }
}
