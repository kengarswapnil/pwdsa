import java.util.Arrays;
import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[] = {4,3,2,7,8,2,3,1};
        System.out.println(missingNumbers2(arr));
    }
    
    public static List<Integer> missingNumbers2(int arr[]){
      int n = arr.length;
      boolean [] visted =  new boolean[n+1];
      
      for(int i=0;i<n;i++){
          if(arr[i] <= n){
              visted[arr[i]] = true;
          }
      }
      
      List<Integer>  res =  new ArrayList<>();
      for(int i=0 ; i <= n; i++ ){
          if(!visted[i]){
              res.add(i);
          }
      }
      
      return res;
    }
}
