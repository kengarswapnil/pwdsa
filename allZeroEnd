
class Main {
    public static void main(String[] args) {
        int arr[] ={1,0,2,3,0,3};
        allZeroEnd(arr);
    }
    
    public static void allZeroEnd(int arr[]){
        int res[] =  new int[arr.length];
        int idx = 0;
        for(int i=0;i<arr.length;i++){
            if(arr[i] != 0){
                res[idx++] = arr[i];
            }
        }
        
        for(int i=0;i<arr.length;i++){
            System.out.print(res[i]+ " ");
        }
    }
    
}
