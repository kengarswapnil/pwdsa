
class Main {
    public static void main(String[] args) {
        int arr [] = {1,2,3,5,6};
        System.out.println(Binary(arr,4));
    }
    
    public static int BinaryWithmin(int arr[],int target  ){
        int start = 0;
        int end =  arr.length -1;
        
        while(start <= end){
            int mid = start + (end - start) / 2;
            if(arr[mid] == target){
                return mid;
            }else if(target < arr[mid] ){
                end = mid -1 ;
            }else{
                start = mid + 1;
            }
        }
        return start;
    }
}
